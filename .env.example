# Copia este archivo como .env y cambia las claves
DB_NAME=obras_v2
DB_USER=obras
DB_PASSWORD=cambia-esta-clave
DB_PORT=5435
# Para correr la API fuera de Docker (npm run start:dev) contra la base del contenedor:
DB_HOST=localhost

JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-al-menos-32-caracteres
JWT_EXPIRES_IN_SECONDS=28800

API_PORT=3000
WEB_PORT=8081
UPLOAD_DIR=./uploads

# Respaldos (contenedor obras_v2_backup)
# Carpeta del servidor donde se guardan; ponla FUERA de la carpeta del proyecto para que no se pierda al reclonar
BACKUP_DIR=/home/docker-ubuntu/backups/obras
# Hora del respaldo diario en formato cron (minuto hora * * *): 23:30 todos los días
BACKUP_CRON=30 23 * * *
